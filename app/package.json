{
  "name": "hanzi-reader",
  "version": "1.0.0",
  "scripts": {
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/jieba-wasm/pkg/web/jieba_rs_wasm_bg.wasm','public/jieba_rs_wasm_bg.wasm')\"",
    "postinstall": "npm run copy-wasm",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "android:sync": "next build && cap sync android",
    "android:apk": "next build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "jieba-wasm": "^2.4.0",
    "next": "^16.4.2",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "private": true
}
